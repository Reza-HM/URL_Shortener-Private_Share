# pnpm dev creates a project-local database when DATABASE_URL is unset.
# DATABASE_URL=postgresql://relay:change-me@127.0.0.1:5432/relay
APP_ORIGIN=http://localhost:3000
STORAGE_DIR=.local/payloads
MAX_FILE_BYTES=26214400
# Set a stable random secret in production (at least 32 characters).
# RATE_LIMIT_SECRET=
